{
  "description": "Zotero 桌面插件：在 Zotero 内维护 AI 技能组（任务模板），按范围扫描文献生成可持久化任务；外部 AI 经 MCP HTTP 接口被动领取并提交交付物。",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "zotero-types": "^4.0.0"
  },
  "name": "zotero-skill-task-mcp",
  "scripts": {
    "build": "node scripts/build.mjs",
    "release": "node scripts/release.mjs",
    "typecheck": "node scripts/gen-locale.mjs && tsc --noEmit",
    "test": "node scripts/test-deliverables.mjs && node scripts/test-ui-wiring.mjs",
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "release:publish": "node scripts/release.mjs --publish"
  },
  "type": "module",
  "version": "0.5.4"
}

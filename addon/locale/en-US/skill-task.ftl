# Skill Task — English locale
# Mozilla Fluent syntax: https://projectfluent.org/
# NOTE: MenuManager menuitems have no text node — labels MUST use
# attribute syntax (.label), a bare message value renders blank.

skill-task-menu-open-panel =
    .label = Skill Task…

# Preferences pane (Zotero Settings → Plugins → Skill Task)
skill-task-prefs-mcp-section = MCP Service
skill-task-prefs-mcp-enable = Enable MCP service
skill-task-prefs-mcp-addr = Service address
skill-task-prefs-mcp-token = Access token
skill-task-prefs-token-show = Show & copy
skill-task-prefs-token-regen = Regenerate
skill-task-prefs-token-hint = The token is shown only on demand; regenerating invalidates the old token immediately. Never put it in logs or share it casually.
skill-task-prefs-task-section = Task defaults
skill-task-prefs-lease = Claim lease (minutes)
skill-task-prefs-maxfile = Max file deliverable size (MB)
skill-task-prefs-task-hint = Changes apply immediately, no restart needed; hard cap 200 MB.
skill-task-prefs-shortcut-section = Keyboard shortcut
skill-task-prefs-shortcut-desc = Open the Skill Task panel (not triggered inside text inputs)

# Skill Task — 中文语言包
# Mozilla Fluent 语法：https://projectfluent.org/
# 注意：MenuManager 的 menuitem 没有文本节点，标签必须用属性语法（.label），
# 直接写消息值会导致菜单显示为空。

skill-task-menu-open-panel =
    .label = 技能任务…

# 设置面板（Zotero 设置 → 插件 → 技能任务）
skill-task-prefs-mcp-section = MCP 服务
skill-task-prefs-mcp-enable = 启用 MCP 服务
skill-task-prefs-mcp-addr = 服务地址
skill-task-prefs-mcp-token = 访问凭据
skill-task-prefs-token-show = 显示并复制
skill-task-prefs-token-regen = 重新生成
skill-task-prefs-token-hint = 凭据只在需要时显示；重新生成后旧凭据立即失效。请勿记入日志或随意分享。
skill-task-prefs-task-section = 任务默认
skill-task-prefs-lease = 领取租约时长（分钟）
skill-task-prefs-maxfile = 文件交付大小上限（MB）
skill-task-prefs-task-hint = 修改实时生效，无需重启；文件上限硬封顶 200MB。
skill-task-prefs-shortcut-section = 快捷键
skill-task-prefs-shortcut-desc = 打开技能任务管理面板（输入框内不触发）
